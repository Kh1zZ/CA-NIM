<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_airing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Header: 3-Day Switcher & Count Badge -->
    <LinearLayout
        android:id="@+id/widget_airing_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <!-- Day 1 (Yesterday / Prev) -->
        <TextView
            android:id="@+id/widget_airing_day_prev"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="KEMARIN"
            android:textColor="#7A7A7A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Day 2 (Today / Active) -->
        <TextView
            android:id="@+id/widget_airing_day_today"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1.3"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:text="HARI INI"
            android:textColor="#0066FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Day 3 (Tomorrow / Next) -->
        <TextView
            android:id="@+id/widget_airing_day_next"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="BESOK"
            android:textColor="#7A7A7A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Count Badge -->
        <TextView
            android:id="@+id/widget_airing_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0 Anime"
            android:textColor="#0066FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_airing_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_airing_header"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_airing_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_airing"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Vertical Scrollable ListView -->
    <ListView
        android:id="@+id/widget_airing_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_airing_header"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fadingEdge="none"
        android:overScrollMode="never"
        android:scrollbars="none" />
</RelativeLayout>
